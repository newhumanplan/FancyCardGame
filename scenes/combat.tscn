[gd_scene load_steps=3 format=3 uid="uid://combat_scene"]

[ext_resource type="Script" path="res://scripts/combat.gd" id="1_combat"]
[ext_resource type="Script" path="res://scripts/combat_ui.gd" id="2_combat_ui"]

[node name="Combat" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="CombatSystem" type="Node" parent="."]
script = ExtResource("1_combat")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 50.0
offset_top = 50.0
offset_right = -50.0
offset_bottom = -50.0
grow_horizontal = 2
grow_vertical = 2

[node name="PhaseLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "战斗阶段"
horizontal_alignment = 1
vertical_alignment = 1

[node name="HSeparator" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="PlayerInfo" type="VBoxContainer" parent="VBox"]
layout_mode = 2

[node name="NameLabel" type="Label" parent="VBox/PlayerInfo"]
layout_mode = 2
text = "玩家"

[node name="HPBar" type="ProgressBar" parent="VBox/PlayerInfo"]
layout_mode = 2
max_value = 100.0
value = 100.0
show_percentage = false

[node name="HPLabel" type="Label" parent="VBox/PlayerInfo"]
layout_mode = 2
text = "100 / 100"

[node name="EnemyInfo" type="VBoxContainer" parent="VBox"]
layout_mode = 2

[node name="NameLabel" type="Label" parent="VBox/EnemyInfo"]
layout_mode = 2
text = "敌人"

[node name="HPBar" type="ProgressBar" parent="VBox/EnemyInfo"]
layout_mode = 2
max_value = 100.0
value = 100.0
show_percentage = false

[node name="HPLabel" type="Label" parent="VBox/EnemyInfo"]
layout_mode = 2
text = "100 / 100"

[node name="HSeparator2" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="ButtonContainer" type="HBoxContainer" parent="VBox"]
layout_mode = 2
alignment = 1

[node name="AttackButton" type="Button" parent="VBox/ButtonContainer"]
layout_mode = 2
text = "攻击"

[node name="SkillButton" type="Button" parent="VBox/ButtonContainer"]
layout_mode = 2
text = "技能"

[node name="HSeparator3" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="CombatLog" type="RichTextLabel" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "战斗日志..."
scroll_following = true

[node name="CombatUI" type="Control" parent="."]
layout_mode = 3
anchors_preset = 0
script = ExtResource("2_combat_ui")
